# Inference
# sarvam uses the OpenAI-compatible API at https://api.sarvam.ai/v1.
# ollama uses a local Ollama server at OLLAMA_BASE_URL / INFERENCE_BASE_URL.
INFERENCE_PROVIDER=sarvam
INFERENCE_API_KEY=YOUR_SARVAM_API_KEY
INFERENCE_MODEL=sarvam-m
INFERENCE_BASE_URL=
INFERENCE_MAX_TOKENS=1200
INFERENCE_REASONING_EFFORT=medium
INFERENCE_TEMPERATURE=
INFERENCE_TIMEOUT_SECONDS=120

# Local Ollama option:
# Smallest current Qwen VLM on Ollama is qwen3.5:0.8b.
# INFERENCE_PROVIDER=ollama
# INFERENCE_BASE_URL=http://localhost:11434
# INFERENCE_MODEL=qwen3.5:0.8b
# INFERENCE_API_KEY=
# INFERENCE_REASONING_EFFORT=
# INFERENCE_TIMEOUT_SECONDS=180
# MODEL_CONTEXT_WINDOW=32768   # sent to Ollama as num_ctx; without it Ollama
#                              # defaults to 4096 and truncates silently
# MULTIMODAL_PAGE_CONTEXT=true
# PAGE_IMAGE_MAX_SIDE=1400
# PAGE_IMAGE_QUALITY=80

# Local nanochat option via patched llama.cpp + DeepGyan OpenAI bridge:
# Start HimalayaAI/llama.cpp llama-server on :8081, then run:
#   python -m tools.deepgyan_openai_bridge
# INFERENCE_PROVIDER=openai-compatible
# INFERENCE_BASE_URL=http://127.0.0.1:8088/v1
# INFERENCE_MODEL=himalayagpt-0.5b-it
# INFERENCE_API_KEY=local
# INFERENCE_MAX_TOKENS=384
# INFERENCE_REASONING_EFFORT=
# INFERENCE_TIMEOUT_SECONDS=300
# MODEL_CONTEXT_WINDOW=2048
# SUMMARY_MAX_TOKENS=160
# CONTEXT_WINDOW=1
# DEEPGYAN_LLAMA_BASE_URL=http://127.0.0.1:8081
# DEEPGYAN_LLAMA_MODEL_ALIAS=himalayagpt-0.5b-it

# Backward-compatible Sarvam aliases; prefer INFERENCE_* for new setups.
SARVAMAI_KEY=YOUR_SARVAM_API_KEY
SARVAM_MODEL=sarvam-m
SARVAM_MAX_TOKENS=1200
SARVAM_REASONING_EFFORT=medium

# Dashboard server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Chapter-level context
# When the chapter containing the current page fits the model window, the whole
# chapter is sent instead of a +/- CONTEXT_WINDOW page slice. Falls back to the
# page window (clamped to the chapter) when it does not fit.
CHAPTER_CONTEXT=true
CHAPTER_OCR_PAGE_CHAR_ESTIMATE=1800
PAGE_IMAGE_TOKEN_ESTIMATE=1100

# Demo catalogue
SEED_DEMO_CATALOG=true
DEMO_CATALOG_DIR=pdfs/cdc-grade-10
PRECOMPUTE_ON_SELECT=true
MULTIMODAL_PAGE_CONTEXT=false
PAGE_IMAGE_MAX_SIDE=1400
PAGE_IMAGE_QUALITY=80

# OCR / PDF processing
TESSERACT_PATH=
OCR_MIN_TEXT_LENGTH=40
OCR_DPI=200
OCR_SEMAPHORE_LIMIT=4
CONTEXT_WINDOW=5
ANALYSIS_CHUNK_SIZE=10

# Embeddings
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_CHARS=8000
EMBEDDING_MAX_RETRIES=3

# Animation plugin jobs
ANIMATION_CONTEXT_MAX_CHARS=9000
ANIMATION_RENDER_TIMEOUT_SECONDS=180

# Postgres (pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=deepgyan
